# Maple ATS System - Environment Configuration Template

# Email Credentials for assessment invitations (Gmail SMTP)
EMAIL_USER=your_email@maplelearningsolutions.com
EMAIL_PASS=your_app_password_here

# Google Sheets Logging Webhook
WEBHOOK_URL=https://script.google.com/macros/s/your_script_id/exec

# Database Configuration (Defaults to SQLite in data/ats_database.db)
DB_TYPE=sqlite
DB_PATH=data/ats_database.db

# File Storage Configuration (Persistent resume storage directory)
STORAGE_DIR=storage/resumes

# Application Settings
MATCH_THRESHOLD_DEFAULT=50
MAX_UPLOAD_SIZE_MB=15
